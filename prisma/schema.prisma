// ============================================================
// COLLEGE MANAGEMENT ERP - PRISMA SCHEMA
// Database: Neon DB (PostgreSQL)
// ORM: Prisma ORM v5+
//
// Scope note: this schema only models what the product currently uses -
// admissions, enrolled student records, classes/courses/exams,
// attendance, and fees. There is no staff/HR module because the college
// has no staff accounts yet, and there is no student-facing login -
// the public site only exposes the admission form. Modules like
// library, hostel, transport, payroll, and announcements were removed
// until they are actually needed.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  PRINCIPAL
  ACCOUNTANT
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_PENDING
  APPROVED
  REJECTED
  ENROLLED
  WAITLISTED
}

enum FeeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  ASSIGNMENT
  PRACTICAL
  SESSIONAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

// ============================================================
// AUTH & USERS
// Only administration accounts exist here (SUPER_ADMIN, ADMIN,
// PRINCIPAL, ACCOUNTANT). They sign in from a private URL only they
// know - see ADMIN_ROUTE_SECRET in the environment.
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================================
// COLLEGE STRUCTURE
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  courses  Course[]
  students Student[]

  @@map("departments")
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. "2024-2025"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  classes       Class[]
  feeStructures FeeStructure[]
  exams         Exam[]

  @@map("academic_years")
}

model Class {
  id             String   @id @default(cuid())
  name           String // e.g. "Diploma in IT - Semester 1"
  section        String? // e.g. "A", "B"
  academicYearId String
  capacity       Int      @default(40)
  classroomId    String?
  createdAt      DateTime @default(now())

  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  classroom    Classroom?     @relation(fields: [classroomId], references: [id])
  students     StudentClass[]
  exams        Exam[]
  attendances  Attendance[]

  @@unique([name, section, academicYearId])
  @@map("classes")
}

model Classroom {
  id        String   @id @default(cuid())
  name      String   @unique
  building  String?
  floor     Int?
  capacity  Int
  hasLab    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  classes Class[]

  @@map("classrooms")
}

// ============================================================
// ADMISSIONS
// This is the only thing a member of the public can submit. There is
// no account created at this step - see AdmissionApplication.
// ============================================================

model AdmissionApplication {
  id                String          @id @default(cuid())
  applicationNumber String          @unique @default(cuid())
  status            AdmissionStatus @default(DRAFT)

  // Personal Info
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  nationality  String?
  cnic         String? @unique
  religion     String?
  motherTongue String?

  // Contact
  email    String
  phone    String
  address  String?
  city     String?
  province String?
  country  String @default("Pakistan")

  // Guardian
  guardianName       String
  guardianRelation   String
  guardianPhone      String
  guardianCnic       String?
  guardianOccupation String?

  // Academic
  desiredProgram String
  previousSchool String
  previousGrade  String?
  previousMarks  Float?

  // Documents - uploaded files are stored on Cloudinary (free tier,
  // 25GB); only the URL/public ID reference is kept here in Neon.
  uploadedDocuments ApplicationDocument[]

  // Review
  reviewedBy    String?
  reviewedAt    DateTime?
  rejectionNote String?
  adminNotes    String?

  submittedAt DateTime?
  enrolledAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student?

  @@index([status])
  @@index([email])
  @@index([applicationNumber])
  @@map("admission_applications")
}

// Stores the actual bytes of each uploaded admission document (DMC,
// B-Form, Father's CNIC, photograph) directly in Neon/Postgres. There is
// no external file-storage service - an admin views/downloads a file
// through a protected /admin route that streams these bytes back.
// Stores a reference to each uploaded admission document (DMC, B-Form,
// Father's CNIC, photograph). The file itself lives on Cloudinary (free
// tier, 25GB) - only the URL and public ID are kept here, so Neon stays
// lightweight regardless of how many applicants upload documents.
model ApplicationDocument {
  id            String   @id @default(cuid())
  applicationId String
  label         String
  fileName      String
  mimeType      String
  fileSize      Int
  url           String
  publicId      String
  createdAt     DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_documents")
}

// ============================================================
// ENROLLED STUDENT RECORDS
// Created by an admin once an application is approved. Students do
// not sign in anywhere on this site at the moment.
// ============================================================

model Student {
  id            String  @id @default(cuid())
  rollNumber    String  @unique
  applicationId String? @unique
  departmentId  String?

  // Personal Info
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  cnic         String? @unique
  profilePhoto String?

  // Contact (record-keeping only - this does not create a login)
  email           String?
  phone           String?
  whatsappNumber  String?
  address         String?

  // Guardian
  guardianName  String?
  guardianPhone String?

  // The calendar-year span this student is enrolled across (e.g. 2024 to
  // 2027 for a 3-year program starting in 2024). This is what the
  // students-list Year filter uses - separate from "Year 1/2/3 of the
  // program", which is encoded in the Class name instead.
  yearStart Int?
  yearEnd   Int?

  admissionDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application   AdmissionApplication? @relation(fields: [applicationId], references: [id])
  department    Department?           @relation(fields: [departmentId], references: [id])
  classes       StudentClass[]
  attendances   Attendance[]
  feePayments   FeePayment[]
  feeStructures StudentFee[]

  @@index([rollNumber])
  @@index([departmentId])
  @@map("students")
}

model StudentClass {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@map("student_classes")
}

// ============================================================
// ACADEMICS
// ============================================================

model Course {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  departmentId String
  creditHours  Int      @default(3)
  description  String?
  isElective   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  exams      Exam[]

  @@index([departmentId])
  @@map("courses")
}

model Exam {
  id             String   @id @default(cuid())
  title          String
  courseId       String
  classId        String
  academicYearId String
  examType       ExamType
  totalMarks     Float
  passingMarks   Float
  scheduledAt    DateTime
  venue          String?
  duration       Int // in minutes
  instructions   String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())

  course       Course       @relation(fields: [courseId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([classId, courseId])
  @@map("exams")
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime         @db.Date
  status    AttendanceStatus
  markedBy  String?
  note      String?
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId, date])
  @@index([studentId, date])
  @@index([classId, date])
  @@map("attendances")
}

// ============================================================
// FINANCIALS
// ============================================================

model FeeStructure {
  id             String   @id @default(cuid())
  name           String
  academicYearId String
  departmentId   String?
  // Which year of the program this applies to (1, 2, or 3) - shown in
  // the admin form as "1st/2nd/3rd Year" rather than a calendar year.
  programYear    Int?

  // Fee categories matching the officially approved fee structure
  // document (admission fee, tuition, board registration, etc.)
  admissionFee         Float @default(0)
  tuitionFee           Float @default(0)
  boardRegistrationFee Float @default(0)
  collegeCardFee       Float @default(0)
  migrationFee         Float @default(0)
  sportsFee            Float @default(0)
  studyTourFee         Float @default(0)
  miscellaneousFee     Float @default(0)

  totalAmount    Float
  dueDate        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  studentFees  StudentFee[]

  @@map("fee_structures")
}

model StudentFee {
  id              String    @id @default(cuid())
  studentId       String
  feeStructureId  String
  status          FeeStatus @default(UNPAID)
  dueDate         DateTime
  paidAmount      Float     @default(0)
  remainingAmount Float
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     FeePayment[]

  @@unique([studentId, feeStructureId])
  @@index([status])
  @@map("student_fees")
}

model FeePayment {
  id            String        @id @default(cuid())
  studentFeeId  String
  studentId     String
  amount        Float
  paymentMethod PaymentMethod
  referenceNo   String?
  receipt       String?       @unique
  paidAt        DateTime      @default(now())
  collectedBy   String?
  remarks       String?

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([paidAt])
  @@map("fee_payments")
}
